digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.55, ranksep=0.75, fontname="DejaVu Sans", fontsize=11, pad=0.3, bgcolor="white"];
  node  [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#444444"];
  label=<<B>Iterator Pattern &#8212; CampusConnect (Facebook-like feed)</B><BR/><FONT POINT-SIZE="9">CSE 3206 Lab 3 &#183; Group 7</FONT>>; labelloc=t;
  "FeedScreen" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E6F4EA" COLOR="#2E6B3F"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#2E6B3F">&laquo;Client&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FeedScreen</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- out_ : std::ostream&amp;</TD></TR><HR/><TR><TD ALIGN="LEFT">+ showProfiles(title, ProfileIterator&amp;) : size_t</TD></TR><TR><TD ALIGN="LEFT">+ showPosts(title, PostIterator&amp;) : size_t</TD></TR><TR><TD ALIGN="LEFT">findMutualFriends(network, a, b) : vector&lt;string&gt;</TD></TR></TABLE>>];
  "SocialNetwork" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3EEFA" COLOR="#2B5C8A"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#2B5C8A">&laquo;interface&raquo; &laquo;Aggregate&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>SocialNetwork</I></B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ createFriendsIterator(id) : unique_ptr&lt;ProfileIterator&gt;</TD></TR><TR><TD ALIGN="LEFT">+ createSuggestionsIterator(id) : unique_ptr&lt;ProfileIterator&gt;</TD></TR><TR><TD ALIGN="LEFT">+ createNewsFeedIterator(id) : unique_ptr&lt;PostIterator&gt;</TD></TR></TABLE>>];
  "Iterator<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3EEFA" COLOR="#2B5C8A"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#2B5C8A">&laquo;interface&raquo; &laquo;Iterator&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>Iterator&lt;T&gt;</I></B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ hasNext() : bool</TD></TR><TR><TD ALIGN="LEFT">+ next() : const T&amp;</TD></TR><TR><TD ALIGN="LEFT">+ reset() : void</TD></TR></TABLE>>];
  "CampusConnect" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1" COLOR="#8A6A1F"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#8A6A1F">&laquo;ConcreteAggregate&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>CampusConnect</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- profiles_ : map&lt;string, Profile&gt;</TD></TR><TR><TD ALIGN="LEFT">- friends_ : map&lt;string, set&lt;string&gt;&gt;  (graph)</TD></TR><TR><TD ALIGN="LEFT">- posts_ : vector&lt;Post&gt;</TD></TR><TR><TD ALIGN="LEFT">- version_ : size_t</TD></TR><HR/><TR><TD ALIGN="LEFT">+ addProfile(profile) : void</TD></TR><TR><TD ALIGN="LEFT">+ addFriendship(a, b) : void</TD></TR><TR><TD ALIGN="LEFT">+ publishPost(authorId, text, likes) : int</TD></TR><TR><TD ALIGN="LEFT">+ profile(id) : const Profile&amp;</TD></TR><TR><TD ALIGN="LEFT">+ friendIdsOf(id) : const set&lt;string&gt;&amp;</TD></TR><TR><TD ALIGN="LEFT">+ posts() : const vector&lt;Post&gt;&amp;</TD></TR><TR><TD ALIGN="LEFT">+ version() : size_t</TD></TR><TR><TD ALIGN="LEFT">+ createFriendsIterator(id)</TD></TR><TR><TD ALIGN="LEFT">+ createSuggestionsIterator(id)</TD></TR><TR><TD ALIGN="LEFT">+ createNewsFeedIterator(id)</TD></TR></TABLE>>];
  "FailFastIterator<T, Key>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEE8F8" COLOR="#5B3F8C"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#5B3F8C">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>FailFastIterator&lt;T, Key&gt;</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT">- network_ : const CampusConnect&amp;</TD></TR><TR><TD ALIGN="LEFT">- order_ : vector&lt;Key&gt;</TD></TR><TR><TD ALIGN="LEFT">- cursor_ : size_t</TD></TR><TR><TD ALIGN="LEFT">- expectedVersion_ : size_t</TD></TR><HR/><TR><TD ALIGN="LEFT">+ hasNext() : bool</TD></TR><TR><TD ALIGN="LEFT">+ next() : const T&amp;</TD></TR><TR><TD ALIGN="LEFT">+ reset() : void</TD></TR><TR><TD ALIGN="LEFT"># resolve(key) : const T&amp;  {abstract}</TD></TR><TR><TD ALIGN="LEFT">- ensureNotModified() : void</TD></TR></TABLE>>];
  "FriendsIterator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1" COLOR="#8A6A1F"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#8A6A1F">&laquo;ConcreteIterator&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>FriendsIterator</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">- collect(network, id) : vector&lt;string&gt;</TD></TR><TR><TD ALIGN="LEFT"># resolve(id) : const Profile&amp;</TD></TR></TABLE>>];
  "SuggestionsIterator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1" COLOR="#8A6A1F"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#8A6A1F">&laquo;ConcreteIterator&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SuggestionsIterator</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">- collect(network, id) : vector&lt;string&gt;</TD></TR><TR><TD ALIGN="LEFT">  (friends-of-friends, BFS depth 2)</TD></TR><TR><TD ALIGN="LEFT"># resolve(id) : const Profile&amp;</TD></TR></TABLE>>];
  "NewsFeedIterator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1" COLOR="#8A6A1F"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#8A6A1F">&laquo;ConcreteIterator&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>NewsFeedIterator</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">- collect(network, id) : vector&lt;size_t&gt;</TD></TR><TR><TD ALIGN="LEFT">  (my + friends&#x27; posts, newest first)</TD></TR><TR><TD ALIGN="LEFT"># resolve(index) : const Post&amp;</TD></TR></TABLE>>];
  "Profile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F2F2F2" COLOR="#666666"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#666666">&laquo;struct&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Profile</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : string</TD></TR><TR><TD ALIGN="LEFT">+ name : string</TD></TR><TR><TD ALIGN="LEFT">+ department : string</TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
  "Post" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F2F2F2" COLOR="#666666"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9" COLOR="#666666">&laquo;struct&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Post</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ id : int</TD></TR><TR><TD ALIGN="LEFT">+ authorId : string</TD></TR><TR><TD ALIGN="LEFT">+ authorName : string</TD></TR><TR><TD ALIGN="LEFT">+ content : string</TD></TR><TR><TD ALIGN="LEFT">+ likes : int</TD></TR><TR><TD ALIGN="LEFT">+ timestamp : long</TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];

  { rank=same; "FeedScreen"; "SocialNetwork"; "Iterator<T>"; }
  { rank=same; "CampusConnect"; "FailFastIterator<T, Key>"; }
  { rank=same; "FriendsIterator"; "SuggestionsIterator"; "NewsFeedIterator"; "Profile"; "Post"; }
  "FriendsIterator" -> "SuggestionsIterator" -> "NewsFeedIterator" -> "Profile" -> "Post" [style=invis];

  "FeedScreen" -> "SocialNetwork" [style=dashed, arrowhead=vee, label=" uses"];
  "FeedScreen" -> "Iterator<T>"   [style=dashed, arrowhead=vee, label=" uses", constraint=false];

  "SocialNetwork" -> "CampusConnect" [dir=back, arrowtail=empty, style=dashed];
  "Iterator<T>"   -> "FailFastIterator<T, Key>" [dir=back, arrowtail=empty, style=dashed];
  "FailFastIterator<T, Key>" -> "FriendsIterator"     [dir=back, arrowtail=empty];
  "FailFastIterator<T, Key>" -> "SuggestionsIterator" [dir=back, arrowtail=empty];
  "FailFastIterator<T, Key>" -> "NewsFeedIterator"    [dir=back, arrowtail=empty];

  "FailFastIterator<T, Key>" -> "CampusConnect" [arrowhead=vee, label=" network_", constraint=false];

  "CampusConnect" -> "FriendsIterator"     [style=dashed, arrowhead=vee, label="«creates»", color="#8A6A1F", fontcolor="#8A6A1F"];
  "CampusConnect" -> "SuggestionsIterator" [style=dashed, arrowhead=vee, color="#8A6A1F"];
  "CampusConnect" -> "NewsFeedIterator"    [style=dashed, arrowhead=vee, color="#8A6A1F"];

  "CampusConnect" -> "Profile" [dir=back, arrowtail=diamond, headlabel="*", labeldistance=1.8];
  "CampusConnect" -> "Post"    [dir=back, arrowtail=diamond, headlabel="*", labeldistance=1.8];
}
